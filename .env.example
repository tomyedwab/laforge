# Webhook Configuration
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=your-webhook-secret-here

# Gitea API Token
# Generate in Gitea: Settings → Applications → Generate New Token
# Required permissions: repository (read and write)
GITEA_TOKEN=your-gitea-api-token-here

# Bot Configuration
# Username of the bot account (to prevent self-triggering on comments)
# Default: laforge
BOT_USERNAME=laforge

# Worker Configuration
# Number of concurrent PR jobs to process (default: 5)
WORKER_CONCURRENCY=5
