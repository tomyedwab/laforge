FROM debian:bookworm-slim

# Install packages and clean up temporary files
RUN apt update && apt install -y \
    curl \
    zip \
    sqlite3 \
    iptables \
    ipset \
    iproute2 \
    dnsutils \
    sudo \
    && apt clean && rm -rf /var/lib/apt/lists/*

# Install Node.js system-wide via NodeSource
ENV NODE_VERSION=22.x
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION} | bash - && \
    apt-get install -y nodejs && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Claude Code globally (accessible to all users)
RUN npm install -g @anthropic-ai/claude-code

COPY claudecode/format-claude-output.js /bin/
COPY claudecode/*.sh /bin/
COPY claudecode/settings.local.json /config/
ADD AGENTS.md /config/CLAUDE.md
COPY prompts/* /config/prompts/

# Set up firewall script
COPY claudecode/init-firewall.sh /usr/local/bin/init-firewall.sh
RUN chmod +x /usr/local/bin/init-firewall.sh

# Create non-root user
RUN useradd -m -u 1000 -s /bin/bash claudecode

# Configure sudoers to allow only firewall initialization
RUN echo "claudecode ALL=(root) NOPASSWD: /usr/local/bin/init-firewall.sh" > /etc/sudoers.d/claudecode-firewall && \
    chmod 0440 /etc/sudoers.d/claudecode-firewall

# Set ownership of workspace and config
RUN mkdir -p /workspace && chown -R claudecode:claudecode /workspace

# Switch to non-root user
USER claudecode

WORKDIR /workspace/repo
